#!/bin/bash
set -e

rm -rf ./build ./Build ./Index ./SuccessionRestore.app ./com.samgisaninja.SuccessionRestore

# Detect if linker supports -ld_classic (Xcode 15+ requires -ld_classic to emit LC_VERSION_MIN_IPHONEOS for iOS 7.0)
EXTRA_LDFLAGS=""
if xcrun ld -ld_classic -v >/dev/null 2>&1; then
    EXTRA_LDFLAGS="-Wl,-ld_classic"
fi

# Detect legacy SDK (e.g. iPhoneOS10.3.sdk or iPhoneOS9.3.sdk from $THEOS/sdks) for iOS 7.0 symbol/runtime compatibility
LEGACY_SDK=""
if [ -n "$THEOS" ] && [ -d "$THEOS/sdks" ]; then
    for sdk in "$THEOS"/sdks/iPhoneOS10*.sdk "$THEOS"/sdks/iPhoneOS9*.sdk "$THEOS"/sdks/iPhoneOS11*.sdk; do
        if [ -d "$sdk" ]; then
            LEGACY_SDK="$sdk"
            break
        fi
    done
fi

echo "COMPILING iOS 7.0+ TARGET..."
if xcodebuild -target SuccessionRestore -xcconfig compile32.xcconfig -configuration Debug \
    CODE_SIGN_IDENTITY="" CODE_SIGNING_REQUIRED=NO CODE_SIGNING_ALLOWED=NO \
    OTHER_LDFLAGS="\$(inherited) $EXTRA_LDFLAGS" >/dev/null 2>&1; then
    echo "Built armv7 + armv7s + arm64 with compile32.xcconfig"
else
    echo "Xcode does not support 32-bit XCBuild target directly; building arm64 (iOS 7.0+ target)..."
    if [ -n "$LEGACY_SDK" ]; then
        xcodebuild -target SuccessionRestore -xcconfig compile32.xcconfig -configuration Debug \
            ARCHS="arm64" VALID_ARCHS="arm64" ONLY_ACTIVE_ARCH=NO \
            IPHONEOS_DEPLOYMENT_TARGET=7.0 \
            CODE_SIGN_IDENTITY="" CODE_SIGNING_REQUIRED=NO CODE_SIGNING_ALLOWED=NO \
            OTHER_CFLAGS="\$(inherited) -isysroot $LEGACY_SDK" \
            OTHER_LDFLAGS="\$(inherited) $EXTRA_LDFLAGS -Wl,-syslibroot,$LEGACY_SDK"
    else
        xcodebuild -target SuccessionRestore -xcconfig compile32.xcconfig -configuration Debug \
            ARCHS="arm64" VALID_ARCHS="arm64" ONLY_ACTIVE_ARCH=NO \
            IPHONEOS_DEPLOYMENT_TARGET=7.0 \
            CODE_SIGN_IDENTITY="" CODE_SIGNING_REQUIRED=NO CODE_SIGNING_ALLOWED=NO \
            OTHER_LDFLAGS="\$(inherited) $EXTRA_LDFLAGS"
    fi
fi

mv ./build/Debug-iphoneos/SuccessionRestore.app ./SuccessionRestore.app
mv ./SuccessionRestore.app/SuccessionRestore ./SuccessionRestore.app/SuccessionRestore_ios7
rm -rf ./build ./Build ./Index

# Force MinimumOSVersion to 7.0 in Info.plist so iOS 7 SpringBoard/installd accepts the app bundle
/usr/libexec/PlistBuddy -c "Set :MinimumOSVersion 7.0" ./SuccessionRestore.app/Info.plist || true

echo "COMPILING ARM64E (iOS 11.0+ TARGET)..."
xcodebuild -target SuccessionRestore -xcconfig compile64.xcconfig -configuration Debug \
    ARCHS="arm64e" VALID_ARCHS="arm64 arm64e" ONLY_ACTIVE_ARCH=NO \
    CODE_SIGN_IDENTITY="" CODE_SIGNING_REQUIRED=NO CODE_SIGNING_ALLOWED=NO
mv ./build/Debug-iphoneos/SuccessionRestore.app/SuccessionRestore ./SuccessionRestore.app/SuccessionRestore_arm64e
rm -rf ./build ./Build ./Index

lipo ./SuccessionRestore.app/SuccessionRestore_ios7 ./SuccessionRestore.app/SuccessionRestore_arm64e \
    -create -output ./SuccessionRestore.app/SuccessionRestore
rm -f ./SuccessionRestore.app/SuccessionRestore_ios7 ./SuccessionRestore.app/SuccessionRestore_arm64e

echo "COMPILING SUCCDATROOT..."
if [ -n "$THEOS" ] && cd ./succdatroot/ && make && cd .. && [ -f ./succdatroot/.theos/obj/debug/succdatroot ]; then
    cp ./succdatroot/.theos/obj/debug/succdatroot ./SuccessionRestore.app/succdatroot
else
    cd "$(dirname "$0")"
    IOS_SDK_PATH=$(xcrun --sdk iphoneos --show-sdk-path)
    ARM64_SDK="${LEGACY_SDK:-$IOS_SDK_PATH}"
    xcrun -sdk iphoneos clang -arch arm64 -miphoneos-version-min=7.0 -isysroot "$ARM64_SDK" $EXTRA_LDFLAGS \
        ./succdatroot/main.c -o ./succdatroot_arm64
    xcrun -sdk iphoneos clang -arch arm64e -miphoneos-version-min=11.0 -isysroot "$IOS_SDK_PATH" \
        ./succdatroot/main.c -o ./succdatroot_arm64e
    if [ -n "$LEGACY_SDK" ] && xcrun -sdk iphoneos clang -target armv7-apple-ios7.0 -isysroot "$LEGACY_SDK" $EXTRA_LDFLAGS -nodefaultlibs -lSystem ./succdatroot/main.c -o ./succdatroot_armv7 2>/dev/null; then
        lipo -create ./succdatroot_armv7 ./succdatroot_arm64 ./succdatroot_arm64e -output ./SuccessionRestore.app/succdatroot
        rm -f ./succdatroot_armv7
    else
        lipo -create ./succdatroot_arm64 ./succdatroot_arm64e -output ./SuccessionRestore.app/succdatroot
    fi
    rm -f ./succdatroot_arm64 ./succdatroot_arm64e
fi

ldid -SSuccessionEntitlements.plist ./SuccessionRestore.app/SuccessionRestore
ldid -S./succdatroot/ent.plist ./SuccessionRestore.app/succdatroot
ldid -SSuccessionEntitlements.plist ./SuccessionRestore.app/attach
ldid -SSuccessionEntitlements.plist ./SuccessionRestore.app/hdik
rm -f ./SuccessionRestore.app/embedded.mobileprovision

mkdir -p ./com.samgisaninja.SuccessionRestore
cp -r ./Template/* ./com.samgisaninja.SuccessionRestore/
chmod 0755 ./com.samgisaninja.SuccessionRestore/DEBIAN/postinst ./com.samgisaninja.SuccessionRestore/DEBIAN/prerm
mkdir -p ./com.samgisaninja.SuccessionRestore/Applications/
mv ./SuccessionRestore.app ./com.samgisaninja.SuccessionRestore/Applications/

fakeroot sh -c '
    chmod 0755 com.samgisaninja.SuccessionRestore/Applications/SuccessionRestore.app/SuccessionRestore
    chmod 6755 com.samgisaninja.SuccessionRestore/Applications/SuccessionRestore.app/succdatroot
    chmod 0755 com.samgisaninja.SuccessionRestore/Applications/SuccessionRestore.app/attach
    chmod 0755 com.samgisaninja.SuccessionRestore/Applications/SuccessionRestore.app/hdik
    find com.samgisaninja.SuccessionRestore -type f -name .DS_Store -delete
    xattr -cr com.samgisaninja.SuccessionRestore || true
    dpkg-deb -Zgzip -b com.samgisaninja.SuccessionRestore com.samgisaninja.successionrestore.deb
'
rm -rf ./com.samgisaninja.SuccessionRestore
echo "SUCCESS: Built com.samgisaninja.successionrestore.deb"
